# Пакет bin/: GUI-only (метаданные + dist-архивы)
#
#   make -f Makefile.package          — resources.conf + VERSION в bin/
#   make -f Makefile.package dist     — архивы для GitHub Release (нужен собранный GUI)
#
# CLI/probe-* больше не входят в релиз (движок встроен в GUI).
# Для отладки CLI: make -f Makefile.diagnose / Makefile.probes

UNAME_S := $(shell uname -s)
VERSION := $(shell cat VERSION 2>/dev/null || echo 0.0.0-dev)

.PHONY: package clean-package linux mac win help dist

package:
	mkdir -p bin
	cp -f resources.conf bin/resources.conf
	cp -f VERSION bin/VERSION
	@# убрать устаревшие CLI-деревья из релизной раскладки (если остались)
	@rm -rf bin/mac bin/linux bin/win 2>/dev/null || true
	@echo "Готово: bin/resources.conf + bin/VERSION (connect-check $(VERSION), GUI-only)"
	@ls -la bin/resources.conf bin/VERSION 2>/dev/null || true

# Архивы для GitHub Releases (не коммитятся — см. .gitignore *.zip / dist/)
dist: package
	mkdir -p dist
	rm -f dist/connect-check-*-$(VERSION).* dist/SHA256SUMS 2>/dev/null || true
	@test -x bin/connect-check-gui-linux || { echo "dist: нет bin/connect-check-gui-linux — сначала make -f Makefile.gui package-linux"; exit 1; }
	@test -d bin/ConnectCheck-mac.app || { echo "dist: нет bin/ConnectCheck-mac.app — сначала make -f Makefile.gui package-mac"; exit 1; }
	@test -f bin/connect-check-gui-win.exe || { echo "dist: нет bin/connect-check-gui-win.exe — сначала make -f Makefile.gui package-win"; exit 1; }
	@cp -f scripts/connect-check-gui-linux.sh bin/connect-check-gui.sh
	@cp -f scripts/connect-check-gui-mac.command bin/ConnectCheck-mac.command
	@cp -f scripts/connect-check-gui-win.cmd bin/connect-check-gui.cmd
	@chmod +x bin/connect-check-gui.sh bin/ConnectCheck-mac.command 2>/dev/null || true
	tar -C bin -czf dist/connect-check-linux-x86_64-$(VERSION).tar.gz \
	  connect-check-gui-linux connect-check-gui.sh libglfw.so.3 VERSION resources.conf
	tar -C bin -czf dist/connect-check-mac-arm64-$(VERSION).tar.gz \
	  ConnectCheck-mac.app ConnectCheck-mac.command VERSION resources.conf
	cd bin && zip -qr ../dist/connect-check-win-x86_64-$(VERSION).zip \
	  connect-check-gui-win.exe connect-check-gui.cmd VERSION resources.conf
	@cd dist && (command -v shasum >/dev/null && shasum -a 256 connect-check-*-$(VERSION).* > SHA256SUMS) || \
	  (command -v sha256sum >/dev/null && sha256sum connect-check-*-$(VERSION).* > SHA256SUMS) || \
	  { echo "Нет shasum/sha256sum — SHA256SUMS не создан"; exit 1; }
	@ls -lh dist/connect-check-*-$(VERSION).* dist/SHA256SUMS
	@echo "dist/ готов — прикрепить к GitHub Release v$(VERSION) (включая SHA256SUMS)"

help:
	@echo "make -f Makefile.package          — resources.conf + VERSION в bin/"
	@echo "make -f Makefile.package dist     — архивы GUI-only в dist/"
	@echo "make -f Makefile.gui package-all  — сборка GUI mac+win+linux"
	@echo "CLI для отладки: make -f Makefile.diagnose / Makefile.probes"

# Совместимость: старые цели mac/linux/win больше не кладут CLI в релиз
mac linux win:
	@echo "CLI в bin/{mac,linux,win} снят с релиза (GUI-only)."
	@echo "Отладка: make -f Makefile.diagnose / Makefile.probes"
	@$(MAKE) -f Makefile.package package

clean-package:
	rm -f bin/resources.conf bin/VERSION bin/DejaVuSans.ttf bin/libglfw.so* bin/.DS_Store
	rm -f bin/connect-check-gui-linux bin/connect-check-gui-win.exe
	rm -f bin/connect-check-gui.sh bin/ConnectCheck-mac.command bin/connect-check-gui.cmd
	rm -rf bin/ConnectCheck-mac.app bin/mac bin/linux bin/win
	@echo "bin/ очищен (README сохранён)"
